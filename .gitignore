# Build outputs (regenerable)
bin/
obj/
*.user
.vs/
.vscode/

# Local release staging and archives
artifacts/
.verification/

# Most UI artwork is compiled locally into the exe and is not kept in the repo.
# The small theme-branding set is versioned so every source build has the headers
# and window icons referenced by the public theme selector.
/Assets/*
!/Assets/Header.png
!/Assets/header2.png
!/Assets/HeaderMayhem.png
!/Assets/Icon.ico
!/Assets/Mayhem.ico

# Anything the tool generates at runtime, and the per-machine settings file
# (it stores absolute paths — never publish it).
Generated/
_generated/
Batcomputer.settings.json

# The mined asset catalog (gamedata/lotdk-*.json) IS shipped — it's reference
# metadata (asset paths + class names), not game content. Exclude only the
# work-in-progress duplicate.
gamedata/*.NEW.json

# Old local source copies (may contain absolute machine paths)
_source_snapshots/

# Internal test harnesses are not distributed with the public tool.
Tests/

# Built locally from Loomirr/retoc-oodle and copied into release output. The
# source and license live in that fork; never commit its binary or Oodle runtime.
Tools/retoc-oodle/*.exe
Tools/retoc-oodle/*.dll

# UE creates these under the bundled registry-writer source on the author's machine.
Tools/BatcomputerRegistryWriter/Binaries/
Tools/BatcomputerRegistryWriter/DerivedDataCache/
Tools/BatcomputerRegistryWriter/Intermediate/
Tools/BatcomputerRegistryWriter/Saved/

# OS
Thumbs.db
Desktop.ini
.DS_Store
