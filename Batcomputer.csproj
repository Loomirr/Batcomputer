<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Batcomputer</AssemblyName>
    <RootNamespace>Batcomputer</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets\Icon.ico')">Assets\Icon.ico</ApplicationIcon>
    <Version>0.9.0-beta.8</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.8</FileVersion>
    <InformationalVersion>0.9.0-beta.8</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Code-built controls do not need designer serialization metadata. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202607" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="UAssetAPI" Version="1.1.0" />
  </ItemGroup>
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Keep the runtime layout beside Debug output; publish settings apply only to Release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Release ships without a loose PDB. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unreal build rules are not part of Batcomputer. -->
    <Compile Remove="Tools\BatcomputerRegistryWriter\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="Generated\**\*.cs" />
    <!-- Embed app art in the single-file release. -->
    <EmbeddedResource Include="Assets\**\*.png" />
    <!-- Red Brick creation is out of scope; only the code-driven, read-only
         base-game palette selector remains in the 3D viewer. -->
    <EmbeddedResource Remove="Assets\RedBricks.png" />
    <EmbeddedResource Include="Assets\**\*.gif" />
    <EmbeddedResource Include="Assets\Font\**\*.otf" />
    <!-- Embed the window and taskbar icon. -->
    <EmbeddedResource Include="Assets\Icon.ico" Condition="Exists('Assets\Icon.ico')" />
    <!-- Offline three.js preview runtime; see licenses/three.js-LICENSE.txt. -->
    <EmbeddedResource Include="Web\preview\*.js" />
    <!-- Shipped game-data catalogs and runtime socket calibration profiles. -->
    <None Update="gamedata\**\*.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <!-- CUE4Parse's ACL helper; keep it matched to the package version. -->
    <None Include="native\CUE4Parse-Natives.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Link="CUE4Parse-Natives.dll" />
    <!-- Copy the locally supplied Oodle-enabled retoc helper and its notice. -->
    <None Remove="Tools\retoc-oodle\retoc.exe" />
    <Content Include="Tools\retoc-oodle\retoc.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"
             Condition="Exists('Tools\retoc-oodle\retoc.exe')" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="licenses\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- D-DIN is bundled under the SIL Open Font License 1.1. Keep the notice with
         the other release licenses instead of publishing a mostly empty Assets tree. -->
    <None Update="Assets\Font\SIL Open Font License.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          TargetPath="licenses\D-DIN-SIL-OFL-1.1.txt" />
    <!-- Bundle the helper source and config, not Unreal build outputs. -->
    <None Remove="Tools\BatcomputerRegistryWriter\Binaries\**\*;Tools\BatcomputerRegistryWriter\DerivedDataCache\**\*;Tools\BatcomputerRegistryWriter\Intermediate\**\*;Tools\BatcomputerRegistryWriter\Saved\**\*" />
    <Content Remove="Tools\BatcomputerRegistryWriter\Binaries\**\*;Tools\BatcomputerRegistryWriter\DerivedDataCache\**\*;Tools\BatcomputerRegistryWriter\Intermediate\**\*;Tools\BatcomputerRegistryWriter\Saved\**\*" />
    <None Update="Tools\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Tools\Build-NativeSuitTemplateIndex.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Tools\BatcomputerRegistryWriter\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Tools\BatcomputerRegistryWriter\Source\**\*.cs"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <!-- Keep the user guides available offline without shipping the web-site build system. -->
    <None Remove="docs\**\*.md" />
    <None Include="docs\**\*.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          TargetPath="Documentation\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="docs\assets\**\*" />
    <None Include="docs\assets\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          TargetPath="Documentation\assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <!-- UAssetAPI 1.1.0 carries its build machine's full CodeView path. Sanitize a
       private intermediate copy before single-file bundling; never alter NuGet's cache. -->
  <Target Name="SanitizeBundledUAssetApiCodeViewPath"
          AfterTargets="PrepareForBundle"
          BeforeTargets="_GenerateSingleFileBundleInputCache"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_UAssetApiBundleInput Include="@(FilesToBundle)"
                             Condition="'%(FilesToBundle.Filename)%(FilesToBundle.Extension)' == 'UAssetAPI.dll'" />
    </ItemGroup>
    <Error Condition="'@(_UAssetApiBundleInput)' == ''"
           Text="Could not find UAssetAPI.dll in the single-file bundle inputs." />
    <Error Condition="'@(_UAssetApiBundleInput->Count())' != '1'"
           Text="Expected exactly one UAssetAPI.dll single-file bundle input." />
    <PropertyGroup>
      <_SanitizedUAssetApiBundleDir>$(IntermediateOutputPath)sanitized-bundle</_SanitizedUAssetApiBundleDir>
      <_SanitizedUAssetApiBundlePath>$(_SanitizedUAssetApiBundleDir)\UAssetAPI.dll</_SanitizedUAssetApiBundlePath>
    </PropertyGroup>
    <MakeDir Directories="$(_SanitizedUAssetApiBundleDir)" />
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\Sanitize-CodeViewPath.ps1&quot; -SourcePath &quot;%(_UAssetApiBundleInput.FullPath)&quot; -DestinationPath &quot;$(_SanitizedUAssetApiBundlePath)&quot; -ExpectedPdbName &quot;UAssetAPI.pdb&quot;" />
    <ItemGroup>
      <FilesToBundle Remove="@(_UAssetApiBundleInput);$(_SanitizedUAssetApiBundlePath)" />
      <FilesToBundle Include="$(_SanitizedUAssetApiBundlePath)">
        <DestinationSubPath>UAssetAPI.dll</DestinationSubPath>
        <RelativePath>UAssetAPI.dll</RelativePath>
        <AssetType>runtime</AssetType>
      </FilesToBundle>
    </ItemGroup>
  </Target>
  <!-- Include the default workspace in portable releases. -->
  <Target Name="CreatePortableGeneratedFolder" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Generated" />
    <WriteLinesToFile File="$(PublishDir)Generated\.gitkeep" Lines="" Overwrite="true" />
  </Target>
  <!-- NuGet supplies WebView2 XML API documentation next to the app by default. It is
       useful while developing but is not a runtime dependency or user document. -->
  <Target Name="CleanPortablePublish" AfterTargets="Publish">
    <ItemGroup>
      <PortableWebViewDocumentation Include="$(PublishDir)Microsoft.Web.WebView2.*.xml" />
    </ItemGroup>
    <Delete Files="@(PortableWebViewDocumentation)" />
  </Target>
</Project>
