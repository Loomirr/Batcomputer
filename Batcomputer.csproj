<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Batcomputer</AssemblyName>
    <RootNamespace>Batcomputer</RootNamespace>
    <ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
    <!-- Code-built controls do not need designer serialization metadata. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202607" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="UAssetAPI" Version="1.1.0" />
  </ItemGroup>
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Keep the runtime layout beside Debug output; publish settings apply only to Release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Release ships without a loose PDB. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unreal build rules are not part of Batcomputer. -->
    <Compile Remove="Tools\SuitSlotsRegistryWriter\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <!-- Embed app art in the single-file release. -->
    <EmbeddedResource Include="Assets\**\*.png" />
    <EmbeddedResource Include="Assets\**\*.gif" />
    <!-- Embed the window and taskbar icon. -->
    <EmbeddedResource Include="Assets\Icon.ico" />
    <!-- Offline three.js preview runtime; see licenses/three.js-LICENSE.txt. -->
    <EmbeddedResource Include="Web\preview\*.js" />
    <!-- Keep one GameData file so timestamp-based loading is deterministic. -->
    <None Update="gamedata\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- CUE4Parse's ACL helper; keep it matched to the package version. -->
    <None Include="native\CUE4Parse-Natives.dll" CopyToOutputDirectory="PreserveNewest" Link="CUE4Parse-Natives.dll" />
    <!-- Copy the locally supplied Oodle-enabled retoc helper and its notice. -->
    <None Remove="Tools\retoc-oodle\retoc.exe" />
    <Content Include="Tools\retoc-oodle\retoc.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"
             Condition="Exists('Tools\retoc-oodle\retoc.exe')" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="licenses\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Bundle author-tool source and config, not Unreal build outputs. -->
    <None Update="Tools\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Tools\Build-NativeSuitTemplateIndex.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Tools\SuitSlotsRegistryWriter\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Tools\SuitSlotsRegistryWriter\Source\**\*.cs"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <!-- Include the default workspace in portable releases. -->
  <Target Name="CreatePortableGeneratedFolder" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Generated" />
  </Target>
</Project>
